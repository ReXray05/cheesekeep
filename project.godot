; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Cheesekeep — La última corteza"
config/version="2.0"
run/main_scene="res://scenes/game/game.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
boot_splash/bg_color=Color(0.145, 0.294, 0.314, 1)
boot_splash/fullsize=false
boot_splash/use_filter=false
boot_splash/image="res://assets/sprites/boot_splash.png"

[audio]

general/default_playback_type=1

[display]

window/size/viewport_height=720
window/size/window_width_override=1152
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.045, 0.06, 1)
